   <item>
    <layout class="QHBoxLayout" name="workAreaLayout" stretch="0,1">
     <property name="spacing">
      <number>8</number>
     </property>
     <item>
      <layout class="QVBoxLayout" name="leftPanelLayout">
       <property name="spacing">
        <number>5</number>
       </property>
       <item>
        <widget class="QTabWidget" name="tabMode">
         <property name="currentIndex">
          <number>0</number>
         </property>
         <widget class="QWidget" name="tabCalibration">
          <attribute name="title">
           <string>Kalibrierung</string>
          </attribute>
          <layout class="QVBoxLayout" name="tabCalibrationLayout">
           <property name="spacing">
            <number>5</number>
           </property>
           <item>
            <widget class="QGroupBox" name="groupIntensitySource">
             <property name="title">
              <string>Intensitätsquelle</string>
             </property>
             <layout class="QHBoxLayout" name="intensitySourceLayout">
              <property name="spacing">
               <number>6</number>
              </property>
              <item>
               <widget class="QLabel" name="labelIntensitySource">
                <property name="text">
                 <string>Quelle:</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QRadioButton" name="radioSourcePolariser">
                <property name="text">
                 <string>Polarisator</string>
                </property>
                <property name="checked">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QRadioButton" name="radioSourceND">
                <property name="text">
                 <string>ND-Filter</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="topControlsRow">
             <property name="spacing">
              <number>5</number>
             </property>
             <item>
              <widget class="QGroupBox" name="groupAlignment">
               <property name="title">
                <string>Polarisator-Ausrichtung</string>
               </property>
               <layout class="QVBoxLayout" name="alignLayout">
                <property name="spacing">
                 <number>3</number>
                </property>
                <item>
                 <layout class="QFormLayout" name="alignForm">
                  <property name="verticalSpacing">
                   <number>3</number>
                  </property>
                  <item row="0" column="0">
                   <widget class="QLabel" name="labelAlignStart">
                    <property name="text">
                     <string>Scanstart (°):</string>
                    </property>
                   </widget>
                  </item>
                  <item row="0" column="1">
                   <widget class="QDoubleSpinBox" name="spinAlignStart">
                    <property name="sizePolicy">
                     <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                      <horstretch>0</horstretch>
                      <verstretch>0</verstretch>
                     </sizepolicy>
                    </property>
                    <property name="toolTip">
                     <string>Startwinkel des Ausrichtungsscans (physikalische Stufenposition)</string>
                    </property>
                    <property name="decimals">
                     <number>1</number>
                    </property>
                    <property name="minimum">
                     <double>0.000000000000000</double>
                    </property>
                    <property name="maximum">
                     <double>360.000000000000000</double>
                    </property>
                    <property name="value">
                     <double>0.000000000000000</double>
                    </property>
                   </widget>
                  </item>
                  <item row="1" column="0">
                   <widget class="QLabel" name="labelAlignEnd">
                    <property name="text">
                     <string>Scanende (°):</string>
                    </property>
                   </widget>
                  </item>
                  <item row="1" column="1">
                   <widget class="QDoubleSpinBox" name="spinAlignEnd">
                    <property name="sizePolicy">
                     <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                      <horstretch>0</horstretch>
                      <verstretch>0</verstretch>
                     </sizepolicy>
                    </property>
                    <property name="toolTip">
                     <string>Endwinkel des Ausrichtungsscans. 180° deckt eine volle cos²-Periode ab.</string>
                    </property>
                    <property name="decimals">
                     <number>1</number>
                    </property>
                    <property name="minimum">
                     <double>0.000000000000000</double>
                    </property>
                    <property name="maximum">
                     <double>360.000000000000000</double>
                    </property>
                    <property name="value">
                     <double>180.000000000000000</double>
                    </property>
                   </widget>
                  </item>
                  <item row="2" column="0">
                   <widget class="QLabel" name="labelAlignNPoints">
                    <property name="text">
                     <string>Schritte:</string>
                    </property>
                   </widget>
                  </item>
                  <item row="2" column="1">
                   <widget class="QSpinBox" name="spinAlignNPoints">
                    <property name="sizePolicy">
                     <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                      <horstretch>0</horstretch>
                      <verstretch>0</verstretch>
                     </sizepolicy>
                    </property>
                    <property name="toolTip">
                     <string>Anzahl Messpunkte im Ausrichtungsscan (empfohlen: ≥36 für 5°-Auflösung über 180°)</string>
                    </property>
                    <property name="minimum">
                     <number>3</number>
                    </property>
                    <property name="maximum">
                     <number>360</number>
