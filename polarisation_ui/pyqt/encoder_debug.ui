           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnSendCommand">
           <property name="toolTip">
            <string>Befehl senden (auch Enter)</string>
           </property>
           <property name="text">
            <string>Senden</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnClearLog">
           <property name="toolTip">
            <string>Terminal-Log leeren</string>
           </property>
           <property name="text">
            <string>Log leeren</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
