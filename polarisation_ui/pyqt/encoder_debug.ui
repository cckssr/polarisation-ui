             <string>Poll-Intervall (SENS:INT?)</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="spbPollInterval">
            <property name="toolTip">
             <string>Aktuelles Abfrageintervall des Arduino in ms (SENS:INT?)</string>
            </property>
            <property name="readOnly">
             <bool>true</bool>
            </property>
            <property name="buttonSymbols">
             <enum>QAbstractSpinBox::ButtonSymbols::NoButtons</enum>
            </property>
            <property name="suffix">
             <string> ms</string>
            </property>
            <property name="maximum">
             <number>9999</number>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="lblDebugMode_lbl">
            <property name="text">
             <string>Debug-Modus (SYST:DEB?)</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QCheckBox" name="cbDebugMode">
            <property name="toolTip">
             <string>Arduino Debug-Ausgabe aktiv (SYST:DEB ON/OFF)</string>
            </property>
            <property name="text">
             <string>Aktiv</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="gbScpiErrors">
         <property name="title">
          <string>SCPI Fehler-Queue (SYST:ERR?)</string>
         </property>
         <layout class="QVBoxLayout" name="vlScpiErrors">
          <item>
           <widget class="QTextEdit" name="teScpiErrors">
            <property name="toolTip">
             <string>Inhalt der SCPI Fehler-Queue (SYST:ERR?)</string>
            </property>
            <property name="readOnly">
             <bool>true</bool>
            </property>
            <property name="placeholderText">
             <string>Keine Fehler</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="hlScpiErrBtns">
            <item>
             <spacer name="hspacerErrQ">
              <property name="orientation">
               <enum>Qt::Orientation::Horizontal</enum>
              </property>
              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
            <item>
             <widget class="QPushButton" name="btnReadScpiErrors">
              <property name="toolTip">
               <string>Alle Einträge aus der SCPI Fehler-Queue lesen</string>
              </property>
              <property name="text">
               <string>Queue auslesen</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnClearScpiErrors">
              <property name="toolTip">
               <string>SCPI Error Queue löschen (*CLS)</string>
              </property>
              <property name="text">
               <string>Queue löschen (*CLS)</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="vspacerSys">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>10</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabTerminal">
      <attribute name="title">
       <string>SCPI Terminal</string>
      </attribute>
      <layout class="QVBoxLayout" name="vlTerminal">
       <item>
        <widget class="QTextEdit" name="teTerminalLog">
         <property name="toolTip">
          <string>SCPI Kommunikationslog</string>
         </property>
         <property name="readOnly">
          <bool>true</bool>
         </property>
         <property name="placeholderText">
          <string>Bereit…</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="hlTerminalInput">
         <item>
          <widget class="QLineEdit" name="leCommandInput">
           <property name="toolTip">
            <string>SCPI-Befehl eingeben, z.B.  MEAS:ANGL? A  oder  *IDN?</string>
           </property>
           <property name="placeholderText">
