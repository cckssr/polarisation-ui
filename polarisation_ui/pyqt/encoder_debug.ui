 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>EncoderDebugDialog</receiver>
   <slot>reject()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>400</x>
     <y>650</y>
    </hint>
    <hint type="destinationlabel">
     <x>400</x>
     <y>340</y>
    </hint>
   </hints>
  </connection>
 </connections>
</ui>
