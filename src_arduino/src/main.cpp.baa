/**
 * SPI Signal Quality Test Generator for Oscilloscope Measurements
 * 
 * This program generates various SPI test signals to measure signal quality
 * with an oscilloscope. It supports different test patterns, data rates,
 * and optional noise injection.
 */

#include <Arduino.h>
#include <SPI.h>

// ============================================================================
// CONFIGURABLE PARAMETERS
// ============================================================================

// SPI Configuration
#define SPI_CLOCK_FREQ      1000000     // SPI clock frequency in Hz (1 MHz)
#define SPI_MODE            SPI_MODE0   // SPI mode (0, 1, 2, or 3)
#define SPI_BIT_ORDER       MSBFIRST    // Bit order: MSBFIRST or LSBFIRST

// Pin Configuration (Arduino Nano ESP32)
#define CS_PIN              10          // Chip Select pin
#define MOSI_PIN            11          // Master Out Slave In (auto-configured by SPI)
#define MISO_PIN            12          // Master In Slave Out (auto-configured by SPI)
#define SCK_PIN             13          // Serial Clock (auto-configured by SPI)

// Test Signal Configuration
#define TEST_PATTERN_TYPE   2           // 0=Alternating, 1=Counter, 2=Random, 3=All-Ones, 4=All-Zeros
#define BURST_SIZE          16          // Number of bytes per burst
#define DELAY_BETWEEN_MS    10          // Delay between bursts in milliseconds

// Noise Configuration
#define ENABLE_NOISE        false       // Enable random noise injection
#define NOISE_PROBABILITY   10          // Noise probability in percent (0-100)

// Signal Monitoring
#define ENABLE_SERIAL       true        // Enable serial output for debugging
#define SERIAL_BAUD         115200      // Serial baud rate
#define STATS_INTERVAL_MS   5000        // Statistics report interval

// ============================================================================
// GLOBAL VARIABLES
// ============================================================================

uint32_t transmissionCount = 0;
uint32_t byteCount = 0;
uint32_t noiseByteCount = 0;
uint32_t lastStatsTime = 0;
uint8_t counterValue = 0;

// ============================================================================
// TEST PATTERN GENERATORS
// ============================================================================

/**
 * Generate test pattern based on selected type
 * @param buffer Output buffer for pattern
 * @param size Number of bytes to generate
 */
void generateTestPattern(uint8_t* buffer, size_t size) {
  switch (TEST_PATTERN_TYPE) {
    case 0: // Alternating pattern (0x55, 0xAA)
      for (size_t i = 0; i < size; i++) {
        buffer[i] = (i % 2 == 0) ? 0x55 : 0xAA;
      }
      break;
      
    case 1: // Counter pattern (incrementing values)
      for (size_t i = 0; i < size; i++) {
        buffer[i] = counterValue++;
      }
      break;
      
    case 2: // Random pattern
      for (size_t i = 0; i < size; i++) {
        buffer[i] = random(0, 256);
      }
      break;
      
    case 3: // All ones (0xFF)
      memset(buffer, 0xFF, size);
      break;
      
    case 4: // All zeros (0x00)
      memset(buffer, 0x00, size);
      break;
      
    default: // Alternating by default
      for (size_t i = 0; i < size; i++) {
        buffer[i] = (i % 2 == 0) ? 0x55 : 0xAA;
      }
  }
}

/**
 * Add noise to test pattern if enabled
 * @param buffer Buffer to add noise to
 * @param size Buffer size
 */
void addNoise(uint8_t* buffer, size_t size) {
  if (!ENABLE_NOISE) return;
  
  for (size_t i = 0; i < size; i++) {
    if (random(100) < NOISE_PROBABILITY) {
      // Flip random bit
      uint8_t bitPosition = random(8);
      buffer[i] ^= (1 << bitPosition);
      noiseByteCount++;
    }
  }
}

// ============================================================================
// SPI TRANSMISSION
// ============================================================================

/**
 * Transmit test data via SPI
 * @param data Data buffer to transmit
 * @param size Number of bytes to transmit
 */
void transmitSPI(uint8_t* data, size_t size) {
  // Assert chip select (active LOW)
  digitalWrite(CS_PIN, LOW);
  delayMicroseconds(1); // Small setup time
  
  // Transfer data
  SPI.transfer(data, size);
  
  delayMicroseconds(1); // Small hold time
  // Deassert chip select
  digitalWrite(CS_PIN, HIGH);
  
  transmissionCount++;
  byteCount += size;
}

// ============================================================================
// STATISTICS & MONITORING
// ============================================================================

/**
 * Print statistics to serial port
 */
void printStats() {
  if (!ENABLE_SERIAL) return;
  
  uint32_t currentTime = millis();
  uint32_t elapsed = currentTime - lastStatsTime;
  
  if (elapsed >= STATS_INTERVAL_MS) {
    float bytesPerSecond = (byteCount * 1000.0) / elapsed;
    float kBitsPerSecond = (bytesPerSecond * 8.0) / 1000.0;
    
    Serial.println("\n========== SPI TEST STATISTICS ==========");
    Serial.print("Transmissions: "); Serial.println(transmissionCount);
    Serial.print("Total Bytes: "); Serial.println(byteCount);
    Serial.print("Throughput: "); Serial.print(kBitsPerSecond, 2); Serial.println(" kbit/s");
    
    if (ENABLE_NOISE) {
      float noisePercentage = (noiseByteCount * 100.0) / byteCount;
      Serial.print("Noise Bytes: "); Serial.print(noiseByteCount);
      Serial.print(" ("); Serial.print(noisePercentage, 2); Serial.println("%)");
    }
    
    Serial.println("=========================================\n");
    
    // Reset counters for next interval
    transmissionCount = 0;
    byteCount = 0;
    noiseByteCount = 0;
    lastStatsTime = currentTime;
  }
}

/**
 * Print configuration at startup
 */
void printConfiguration() {
  if (!ENABLE_SERIAL) return;
  
  Serial.println("\n========== SPI SIGNAL GENERATOR CONFIG ==========");
  Serial.print("SPI Clock: "); Serial.print(SPI_CLOCK_FREQ / 1000.0); Serial.println(" kHz");
  Serial.print("SPI Mode: "); Serial.println(SPI_MODE);
  Serial.print("Bit Order: "); Serial.println(SPI_BIT_ORDER == MSBFIRST ? "MSB First" : "LSB First");
  Serial.print("CS Pin: "); Serial.println(CS_PIN);
  Serial.println();
  
  Serial.print("Test Pattern: ");
  switch (TEST_PATTERN_TYPE) {
    case 0: Serial.println("Alternating (0x55/0xAA)"); break;
    case 1: Serial.println("Counter (0x00-0xFF)"); break;
    case 2: Serial.println("Random"); break;
    case 3: Serial.println("All Ones (0xFF)"); break;
    case 4: Serial.println("All Zeros (0x00)"); break;
    default: Serial.println("Unknown"); break;
  }
  
  Serial.print("Burst Size: "); Serial.print(BURST_SIZE); Serial.println(" bytes");
  Serial.print("Delay Between Bursts: "); Serial.print(DELAY_BETWEEN_MS); Serial.println(" ms");
  Serial.println();
  
  Serial.print("Noise: "); Serial.println(ENABLE_NOISE ? "ENABLED" : "DISABLED");
  if (ENABLE_NOISE) {
    Serial.print("Noise Probability: "); Serial.print(NOISE_PROBABILITY); Serial.println("%");
  }
  
  Serial.println("=================================================\n");
  Serial.println("Starting continuous transmission...\n");
}

// ============================================================================
// ARDUINO SETUP & LOOP
// ============================================================================

void setup() {
  // Initialize serial if enabled
  if (ENABLE_SERIAL) {
    Serial.begin(SERIAL_BAUD);
    delay(1000); // Wait for serial connection
  }
  
  // Initialize random seed
  randomSeed(analogRead(0));
  
  // Configure CS pin
  pinMode(CS_PIN, OUTPUT);
  digitalWrite(CS_PIN, HIGH); // Deasserted by default
  
  // Initialize SPI
  SPI.begin();
  SPI.beginTransaction(SPISettings(SPI_CLOCK_FREQ, SPI_BIT_ORDER, SPI_MODE));
  
  // Print configuration
  printConfiguration();
  
  // Initialize timing
  lastStatsTime = millis();
}

void loop() {
  // Generate test pattern
  uint8_t testData[BURST_SIZE];
  generateTestPattern(testData, BURST_SIZE);
  
  // Add noise if enabled
  addNoise(testData, BURST_SIZE);
  
  // Transmit via SPI
  transmitSPI(testData, BURST_SIZE);
  
  // Print statistics periodically
  printStats();
  
  // Delay before next burst
  if (DELAY_BETWEEN_MS > 0) {
    delay(DELAY_BETWEEN_MS);
  }
}
